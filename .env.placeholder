# eYatra environment settings
#
# Copy this file to `.env` (same folder) and fill in real values:
#   Windows:  Copy-Item .env.placeholder .env
#
# `.env` is gitignored and denied by .htaccess, so secrets never reach git or
# the browser. wp-config.php reads these keys (with built-in fallbacks), so a
# missing `.env` still boots the site.
#
# Keys are plain KEY=value. Blank lines and lines starting with "#" are ignored.
# A value may be wrapped in single or double quotes.

# --- Database ---
DB_NAME=eYatraWorld
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost

# --- Site address (single source for the domain) ---
# Local dev uses http://eyatraworld.test; in the production.

WP_HOME=http://eyatraworld.test
WP_SITEURL=http://eyatraworld.test

# --- Gmail SMTP relay (used by wp-content/plugins/eyatra-smtp) ---
# EYATRA_SMTP_PASSWORD is a 16-char Google "App Password"
# Comment the EYATRA_SMTP_HOST to fall back to plain mail().
EYATRA_SMTP_HOST=smtp.gmail.com
EYATRA_SMTP_PORT=465
EYATRA_SMTP_SECURE=ssl
EYATRA_SMTP_USERNAME=you@example.com
EYATRA_SMTP_PASSWORD=REPLACE_WITH_16_CHAR_APP_PASSWORD
EYATRA_SMTP_FROM=you@example.com
EYATRA_SMTP_FROM_NAME=eYatra
